{
  "manifest_version": 3,
  "name": "セーフサイン",
  "version": "1.0.0",
  "description": "募集や仕事の文章を貼り付けるだけで、危険信号をその場で判定。安全度を信号で表示する無料ツールです。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "セーフサイン",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"]
}
